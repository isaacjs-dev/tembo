{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tembo.local/contracts/omr/dataset-manifest.schema.json",
  "title": "Tembo OMR annotated dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "split", "status", "threshold_profile", "samples"],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$" },
    "split": { "enum": ["tuning", "holdout"] },
    "status": { "enum": ["synthetic_baseline", "collecting", "sealed"] },
    "threshold_profile": { "type": "string", "minLength": 1, "maxLength": 100 },
    "samples": {
      "type": "array",
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "group_id", "source", "contract", "ground_truth", "capture", "conditions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$" },
        "group_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$" },
        "source": { "$ref": "#/$defs/source" },
        "contract": { "$ref": "#/$defs/contract" },
        "ground_truth": { "$ref": "#/$defs/groundTruth" },
        "capture": { "$ref": "#/$defs/capture" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,60}$" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sha256", "provenance", "license", "rights_reference", "pii", "consent", "retention_policy"],
      "properties": {
        "kind": { "enum": ["synthetic", "physical"] },
        "uri": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provenance": { "type": "string", "minLength": 1, "maxLength": 300 },
        "license": { "enum": ["generated", "consented_private", "redistributable"] },
        "rights_reference": { "type": "string", "minLength": 1, "maxLength": 300 },
        "pii": { "enum": ["none", "anonymized", "contains_personal_data"] },
        "consent": { "enum": ["not_applicable", "documented"] },
        "retention_policy": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qr_version", "qr_contract_hash", "template_slug", "template_version", "template_hash", "page", "total_pages", "qs", "qe", "rpp", "oc", "g"],
      "properties": {
        "qr_version": { "type": "integer", "minimum": 3, "maximum": 5 },
        "qr_contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "template_slug": { "type": "string", "minLength": 1, "maxLength": 100 },
        "template_version": { "type": "integer", "minimum": 1 },
        "template_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "page": { "type": "integer", "minimum": 1 },
        "total_pages": { "type": "integer", "minimum": 1 },
        "qs": { "type": "integer", "minimum": 1 },
        "qe": { "type": "integer", "minimum": 1 },
        "rpp": { "type": "integer", "minimum": 1 },
        "oc": { "type": "string", "pattern": "^(?:0|[2-9])+$" },
        "g": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      }
    },
    "groundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fiducials", "annotation", "questions"],
      "properties": {
        "fiducials": { "enum": ["all_visible", "partial", "absent"] },
        "annotation": { "$ref": "#/$defs/annotation" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/questionTruth" }
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "annotators", "adjudicated", "adjudicator", "protocol_version"],
      "properties": {
        "method": { "enum": ["deterministic_generator", "manual_double_annotation"] },
        "annotators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "adjudicated": { "type": "boolean" },
        "adjudicator": { "type": ["string", "null"], "maxLength": 100 },
        "protocol_version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "questionTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "state", "selected_index", "marked_indices", "expected_action", "recipe"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["answered", "blank", "weak", "erased", "multiple_marks", "ambiguous"] },
        "selected_index": { "type": ["integer", "null"], "minimum": 0 },
        "marked_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "expected_action": { "enum": ["accept", "review", "rescan"] },
        "recipe": {
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": { "enum": ["empty", "strong", "weak", "erased", "ambiguous"] }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_class", "device_model", "camera", "width", "height", "distance_mm", "angle_degrees", "illumination", "shadow", "blur", "paper", "printer", "scale", "compression"],
      "properties": {
        "device_class": { "enum": ["synthetic", "low", "mid", "high"] },
        "device_model": { "type": ["string", "null"], "maxLength": 120 },
        "camera": { "type": "string", "minLength": 1, "maxLength": 120 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "distance_mm": { "type": ["number", "null"], "minimum": 0 },
        "angle_degrees": { "type": "number", "minimum": -180, "maximum": 180 },
        "illumination": { "enum": ["synthetic_even", "low", "normal", "high", "mixed"] },
        "shadow": { "enum": ["none", "partial", "strong"] },
        "blur": { "enum": ["none", "mild", "strong"] },
        "paper": { "type": "string", "minLength": 1, "maxLength": 100 },
        "printer": { "type": "string", "minLength": 1, "maxLength": 120 },
        "scale": { "enum": ["95", "100", "fit", "synthetic"] },
        "compression": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
