{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:js": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:omr-dataset": "node --experimental-strip-types tests/omr-dataset.mjs",
        "test:omr-dataset:holdout": "node --experimental-strip-types tests/omr-dataset.mjs --split=holdout --confirm-frozen-profile",
        "test:omr-dataset:gates": "node --experimental-strip-types tests/omr-dataset.mjs --split=holdout --confirm-frozen-profile --require-gates",
        "test:qr-raster": "node tests/qr-raster.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "ajv": "^8.20.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7",
        "vitest": "^4.1.5"
    },
    "dependencies": {
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "chart.js": "^4.5.1",
        "jsqr": "^1.4.0",
        "konva": "^10.3.0",
        "material-symbols": "^0.45.9",
        "pdfjs-dist": "^6.2.108",
        "sortablejs": "^1.15.7"
    }
}
