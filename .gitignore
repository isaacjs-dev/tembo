# Local and production secrets (examples remain versioned)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/auth.json

# Dependencies and generated build state
**/node_modules/
**/vendor/
# OpenCV is a browser runtime asset, not a Composer dependency. Keep the
# pinned copy in source control so a release cannot publish the OMR worker
# without the runtime it loads.
!platform/public/vendor/
!platform/public/vendor/opencv/
!platform/public/vendor/opencv/opencv-4.8.0.js
!platform/public/vendor/opencv/LICENSE
**/.gradle/
**/.expo/
**/.kotlin/
**/dist/
**/web-build/
**/build/
**/public/build/
**/public/hot
**/public/storage

# Databases, runtime data and diagnostics
**/*.sqlite
**/*.sqlite-*
**/*.log
**/.phpunit.result.cache
**/.phpunit.cache/
**/storage/framework/cache/**
**/storage/framework/sessions/**
**/storage/framework/views/**
**/storage/logs/**

# Signing material and private keys
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.pem
**/*.key
**/*.mobileprovision

# IDE/OS state
.claude/
.vscode/
**/.idea/
**/.fleet/
**/.nova/
**/.zed/
**/.DS_Store
**/Thumbs.db

# Generated release artifacts are distributed outside Git
**/*.apk
**/*.aab
